{
  "name": "jazz-scales-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "NUXT_CONTACT_DRY_RUN=true nuxt build && NUXT_CONTACT_DRY_RUN=true nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.engine.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "e2e": "NUXT_PUBLIC_FEATURES_NEW_CHART=true NUXT_PUBLIC_FEATURES_GUIDE_TONES=true NUXT_PUBLIC_FEATURES_PRACTICE=true nuxt build && playwright test",
    "check:headers": "NITRO_PRESET=vercel nuxt build && node build/check-headers.ts"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "happy-dom": "20.14.5",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "dependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "@headlessui/vue": "1.7.23",
    "@heroicons/vue": "2.2.0",
    "vexflow": "5.0.0",
    "vue": "3.5.43"
  },
  "engines": {
    "node": "24.x"
  }
}
