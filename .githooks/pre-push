#!/bin/sh
# runs `make docs` (the decision anchors and the link check) when the pushed commits touch the documentation pages or
# the decision registry, and `make a11y` (the accessibility lint and the axe scans) when they touch the interface
# (web/app/); both: one build, a11y's, for the link check too (CI checks links on the production build). Other pushes
# go straight through. Installed by `make setup` (git config core.hooksPath .githooks); skip once with
# `git push --no-verify`.
# DOCS is what make docs checks, not what the docs gate (web/build/docsGate.ts) counts as docs: rules.ts holds RULES,
# which the Functions page prints, so a change to it can break an anchor; the gate counts it as behaviour (#407)
zero=0000000000000000000000000000000000000000
DOCS="web/app/pages/help.vue web/app/pages/functions.vue web/app/pages/how-it-decides.vue web/app/pages/release-notes.vue web/app/utils/releaseNotes.ts web/app/pages/chart-format.vue web/app/pages/glossary.vue engine/src/decisions.ts engine/src/analysis/rules.ts"
app=""
docs=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a deleted branch
  if [ "$remote_sha" = "$zero" ]; then
    # a new branch: what it adds to main
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || base=""
  else
    base=$remote_sha
  fi
  if [ -n "$base" ]; then
    app="$app$(git diff --name-only "$base" "$local_sha" -- web/app/)"
    # shellcheck disable=SC2086 # DOCS is a list of paths
    docs="$docs$(git diff --name-only "$base" "$local_sha" -- $DOCS)"
  else
    app="${app}unknown" # no base to compare with: check
    docs="${docs}unknown"
  fi
done
if [ -n "$docs" ] && [ -n "$app" ]; then
  echo "pre-push: the docs and the interface changed; running the docs tests, make a11y and the link check (skip with git push --no-verify)"
  (cd web && npx vitest run test/docs) || exit 1
  make a11y || exit 1
  (cd web && npm run check:links) || exit 1
elif [ -n "$docs" ]; then
  echo "pre-push: the docs changed; running make docs (skip with git push --no-verify)"
  make docs || exit 1
elif [ -n "$app" ]; then
  echo "pre-push: the interface changed; running make a11y (skip with git push --no-verify)"
  make a11y || exit 1
fi
exit 0
